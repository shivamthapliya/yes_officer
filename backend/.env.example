DATABASE_URL=postgresql://postgres:<password>@localhost:5432/yes_officer
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
SECRET_KEY=<generate: python -c "import secrets;print(secrets.token_urlsafe(48))">
INTERNAL_SHARED_SECRET=<generate a different random value>
INTERNAL_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
# AI chat analysis: set ONE key. Groq (free tier, groq.com) is used first if both are set.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Empty = provider default (groq: openai/gpt-oss-120b, anthropic: claude-opus-5-5)
LLM_MODEL=
